# Database Configuration
# Use file-based SQLite for development to share data between services
DB_PATH=./live-traffic.db

# Use 'memory' for in-memory SQLite (default)
# Use 'sqlite' for file-based SQLite
DB_KIND=sqlite

# NDW Adapter Configuration
# Set to true to cache decompressed XML files locally
# Cache is stored in .ndw-cache/ directory
NDW_USE_CACHE=true

# Logging
LOG_LEVEL=verbose

# API Server
PORT=3000

# Web App
VITE_WS_URL=ws://localhost:3000/ws
