# Railway Environment Configuration
# Copy this to Railway's Variables section

# ==========================================
# REQUIRED - Database Configuration
# ==========================================

# Railway automatically provides this when you add PostgreSQL service
# DATABASE_URL=postgresql://user:password@host:5432/live_traffic

DB_KIND=postgres
# NOTE: Do NOT set DB_PATH in production (PostgreSQL only)

# ==========================================
# API Server Configuration
# ==========================================

PORT=3000
CORS_ORIGIN=https://your-custom-domain.railway.app

# ==========================================
# Web App Configuration  
# ==========================================

# Must match your Railway domain
VITE_WS_URL=wss://your-custom-domain.railway.app/ws
VITE_API_BASE=https://your-custom-domain.railway.app

# ==========================================
# NDW Adapter Configuration
# ==========================================

# Use cache to reduce API calls (stored in container)
NDW_USE_CACHE=true

# Logging level for production
LOG_LEVEL=info

# ==========================================
# Railway / Node Configuration
# ==========================================

NODE_ENV=production

# ==========================================
# Setup Instructions
# ==========================================

# 1. In Railway Dashboard:
#    - New Project → Select GitHub Repo
#    - New → Database → PostgreSQL
#    
# 2. For each environment variable above:
#    - Enter the variable name and value
#    - Replace "your-custom-domain" with your actual domain
#    - Railway auto-fills DATABASE_URL (no need to set manually)
#
# 3. Connect GitHub for auto-deploy:
#    - Settings → Connect Git
#    - Select branch (main)
#    - Automatic deploys enabled
#
# 4. After deployment:
#    - Add custom domain (Settings → Domain)
#    - Update VITE_WS_URL and VITE_API_BASE
#    - Redeploy for changes to take effect
